# The server's .env, read by deploy/compose.yaml. Copy to /opt/lunar/.env on the VPS and
# fill in the values there. The real file is not in git.

# Token of the Cloudflare tunnel "lunar". Required: the stack does not start without it.
TUNNEL_TOKEN=

# Assistant (the requirement). Paste the OpenRouter key after the = sign, with no quotes.
# With the key or the model empty the assistant answers in offline mode.
OPENROUTER_API_KEY=
# OpenRouter model id, as https://openrouter.ai/api/v1/models lists it.
LUNAR_ASSISTANT_MODEL=deepseek/deepseek-v4.1-flash-1017
# Questions a day before the assistant switches to offline mode.
LUNAR_ASSISTANT_DAILY_REQUESTS=300
# Questions a minute from one IP before it gets a 503 with Retry-After.
LUNAR_ASSISTANT_IP_LIMIT_PER_MINUTE=10

# Where deploy/fetch-data.sh puts the engine data. Optional; this is the default.
# LUNAR_DATA_DIR=/opt/lunar-data
